---
layout: base
---

<header class="px-6 pt-20 mb-6">
    <div class="h-10 md:h-12">
    <a aria-label="navigate previous page" href="{{ pagination.href.previous | default: pagination.href.last}}"
      class="text-base tooltip tooltip-bottom" data-tip="Previous item">
        ◀ PREVIOUS 
    </a>
    <span class="mx-4"></span>
    <a aria-label="navigate next page" href="{{ pagination.href.next | default: pagination.href.first }}"
      class="text-base tooltip tooltip-bottom" data-tip="Next item">
      NEXT <span class="text-base"> ▶</span>
    </a>
  </div>
  <div class="">
    <h1 class="text-secondary text-5xl mb-12 md:text-4xl md:tracking-tight font-bold leading-tight max-w-3xl">
     {{ item.label }}
    </h1>
  </div>

</header>

<section class="px-6 md:px-6">
  <div class="flex flex-col md:flex-row md:gap-6 w-full">
    <div class="w-full md:w-1/2 min-h-100 mb-6 md:mb-12">
      {% include "item/image-viewer" %}
    </div>
    <div class="w-full md:w-1/2 mb-12">
      {% include "item/metadata-table" %}
    </div>
  </div>
</section>